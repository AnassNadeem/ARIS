# Streamlit Cloud reads st.secrets from a secrets.toml provisioned in the
# app's Settings -> Secrets pane (not from this repo). This file is the
# committed template documenting the shape of that secrets blob.
#
# Local dev does NOT need this file: db.engine() falls back to ARIS_DB_URL
# from the gitignored .env at the repo root.
#
# To deploy:
#   1) Provision a managed Postgres (Neon free tier).
#   2) In Streamlit Cloud -> Settings -> Secrets, paste the line below with
#      the Neon connection string (must include `sslmode=require`).

ARIS_DB_URL = "postgresql+psycopg://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Paid OpenF1 key — pick ONE shape (never commit real values):
# OPENF1_API_KEY = "your-bearer-or-api-key"
# OPENF1_USERNAME = ""
# OPENF1_PASSWORD = ""
