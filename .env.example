# ARIS local environment — template.
# Copy to .env (gitignored) and set real values before `docker compose up`.
#
#   cp .env.example .env
#
POSTGRES_USER=aris
POSTGRES_PASSWORD=change_me_local_dev
POSTGRES_DB=aris

# SQLAlchemy connection string used by src/aris/io/db.py (wired up Day 2).
# Heroku also accepts DATABASE_URL (postgres://…); the app rewrites it to
# postgresql+psycopg://… automatically.
ARIS_DB_URL=postgresql+psycopg://aris:change_me_local_dev@127.0.0.1:5432/aris

# ARIS application cache (replay packs, HTTP catalog). FastF1's native
# filesystem cache is a separate layer and stays on disk — ephemeral on Heroku.
#   disk     — local development (default)
#   postgres — production (survives dyno restart; does not persist FastF1)
ARIS_CACHE_BACKEND=disk

# Comma-separated browser origins allowed to call the API (CORS).
# Local default when unset: Vite 5173 + Next 3000.
# Production: set to the Cloudflare Pages URL (no code change needed).
# ARIS_FRONTEND_ORIGIN=https://YOUR-PAGES-PROJECT.pages.dev

# Optional. Unset = no-op (local dev does not need a Sentry account).
# SENTRY_DSN=

# G2 true-compound C-code slope overlay. Default is off: simulate()/recommend()/
# Strategy UI use G1.5 global fallback slopes (0.08/0.05/0.03) + G1.4 physics-delta.
# Set to 1 (unconstrained G2), isotonic (G3 constrained), or pooled (G4 GBT) to opt in.
# Independent of the fit_zandvoort_tire_slopes.py live-write gate (21–23 Aug 2026).
# Event day: leave unset.
# ARIS_TRUE_COMPOUND_SLOPES=off

# Sector clock. Default (unset) waits 25 s / speed. ARIS_FAST_CLOCK=1 is
# screenshot-harness only — SectorClock warns and skips the live cadence.
# Event day: leave unset.
# ARIS_FAST_CLOCK=1

# Watch propose/resolve JSONL under results/decisions/. Default (unset) is on.
# Set to 0 to disable. Write failures raise RuntimeError (not silent).
# Event day: leave ARIS_DECISION_LOG unset (default on).
# ARIS_DECISION_LOG=0
# ARIS_DECISION_LOG_DIR=results/decisions

# OpenF1 live REST. Required while a session is in progress (public API is 401).
# Get an account at https://openf1.org/auth.html — never commit real values.
# OPENF1_USERNAME=
# OPENF1_PASSWORD=
# OPENF1_API_KEY=

# Ask ARIS unit tests pin this to data/ask/fixtures/decisions.jsonl.
# Live index: unset (uses results/decisions/ + fixture). Overlay-walk
# proposes are excluded from Ask unless ARIS_ASK_INCLUDE_OVERLAY_DECISIONS=1.
# ARIS_ASK_DECISION_DIRS=results/decisions
# ARIS_ASK_INCLUDE_OVERLAY_DECISIONS=1

# Background FastF1 / ingest pre-warm on process start. Default off.
# A 512MB Heroku Basic dyno OOMs (R15) if GPS/car_data sessions load at boot.
# Leave unset in production — the cache fills lazily on the first request.
# ARIS_ENABLE_PREWARM=true

# Max concurrent FastF1 session loads (including GPS/car_data). Default 1.
# ARIS_MAX_CONCURRENT_LOADS=1
