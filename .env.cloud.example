# ARIS cloud (Neon Postgres + Streamlit Cloud) environment — template.
# Copy to .env.cloud (gitignored) and paste your real Neon URL in the line below.
#
#   Copy-Item .env.cloud.example .env.cloud
#   notepad .env.cloud
#
# The Neon dashboard gives you a string like:
#     postgresql://USER:PASSWORD@HOST.eu-west-2.aws.neon.tech/aris
#
# You must rewrite it for this stack before pasting below:
#   1) Replace the leading  postgresql://      with  postgresql+psycopg://
#   2) Append                ?sslmode=require   to the end
#
# Final shape:
#     postgresql+psycopg://USER:PASSWORD@HOST.eu-west-2.aws.neon.tech/aris?sslmode=require
#
# Paste that final, rewritten string after the `=` below (no quotes, no spaces).

ARIS_DB_URL=postgresql+psycopg://USER:PASSWORD@HOST.eu-west-2.aws.neon.tech/aris?sslmode=require
