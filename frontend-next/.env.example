# Cloudflare Pages (and local production builds) inject these at build time.
# The browser never falls back to localhost in production.

# Heroku FastAPI origin, no trailing slash. Required on Pages for /api + WebSocket.
# Production: the Heroku app URL from `heroku apps:info`.
# NEXT_PUBLIC_API_BASE=https://YOUR-APP.herokuapp.com

# Optional. Derived from NEXT_PUBLIC_API_BASE (http→ws, https→wss) when unset.
# NEXT_PUBLIC_WS_BASE=wss://YOUR-APP.herokuapp.com

# Server-side rewrite target for `next start`. Pages static builds can leave this
# unset if NEXT_PUBLIC_API_BASE already points at Heroku.
# ARIS_BACKEND_ORIGIN=https://YOUR-APP.herokuapp.com

# Cloudflare R2 public bucket URL for static replay JSON.
# Local: /r2replay (Next.js serves public/r2replay or proxies to R2_PUBLIC_ORIGIN).
# Cloudflare Pages: the bucket's public URL (https://pub-xxxx.r2.dev).
# Production example (default in next.config.ts if unset):
# NEXT_PUBLIC_R2_BASE_URL=https://pub-9429cde26be84c4c8034f0b5873b9a7d.r2.dev
