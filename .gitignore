# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Jupyter
.ipynb_checkpoints/

# FastF1 cache (regenerable, can be GBs)
fastf1_cache/
cache/

# V3 React app
frontend-next/node_modules/
frontend-next/out/
frontend/node_modules/
frontend/dist/

# Local extra Python deps (OneDrive-safe target install)
.deps/

# Data & models (too big for git)
data/raw/*
data/processed/*
data/replay_r2/
!data/raw/.gitkeep
!data/processed/.gitkeep
models/*
!models/.gitkeep
!models/circuit_deg_slopes.json
# CQL artefacts — regenerable, allowed to stay untracked.
# Do not commit cql_q_network_test.pt or the test normalisation/dataset.
models/cql_q_network.pt
models/cql_q_network_test.pt
models/cql_normalisation.json
models/cql_normalisation_test.json
data/cql_dataset.parquet
data/cql_dataset_test.parquet
results/*
!results/.gitkeep
!results/wk2-baseline-mae.csv
!results/wk2-window-sweep.csv
!results/heldout-laptime-mae.csv

# Built Ask ARIS FAISS index (rebuild: python scripts/build_ask_index.py)
data/ask/index/*
!data/ask/index/.gitkeep

# Parquet & pickles outside the data dir
*.parquet
*.pkl
*.pickle

# Secrets & env
.env
.env.*
!.env.example
!.env.cloud.example
!.env.development
!.env.production
.dev.vars
*.key

# Cloudflare / Node (optional Worker under deploy/cloudflare-worker/)
node_modules/
worker-configuration.d.ts
deploy/cloudflare-worker/node_modules/

# OS / IDE
.DS_Store
Thumbs.db
.vscode/
.idea/

# Claude Code local state (personal, not portable)
.claude/

# docs/: public top-level markdown; keep planning/learning + private audits local
docs/planning/
docs/learning/
docs/journal/
docs/REPO-STATUS-*.md

# One-off diagnosis scripts (local only; see scripts/_archive/)
scripts/_*.py
scripts/_archive/

# Local GPS chunk packs from scripts/build_replay_pack.py (production replay is R2)
static_replays/*
!static_replays/README.md
!static_replays/.gitkeep

# Logs (never re-commit console / rebuild dumps)
*.log
r2_build_log.txt
aris_rebuild_*.log
aris_all_drivers*.log
wandb/
mlruns/
.gstack/

# Coverage
.coverage
coverage.xml
htmlcov/
*.cover
